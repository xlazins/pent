# Copy this file to .env and fill in your own values. Never commit .env.

# Tells the Strix CLI which model to use to think during scans.
# Free option: a Gemini key from https://aistudio.google.com (Get API Key)
STRIX_LLM=gemini/gemini-2.5-flash
LLM_API_KEY=your-gemini-or-other-provider-key-here

# Used separately by this dashboard to translate raw findings into plain English.
# Can be the same Gemini key as above.
GEMINI_API_KEY=your-gemini-key-here

# Optional: change the local port
PORT=4000
